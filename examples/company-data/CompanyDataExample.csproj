<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Company-data example (connections / request fields / change feed / webhooks / documents)
    for the allus company-data C# SDK.

    Its OWN project — a standalone web app that hosts a thin localhost backend implementing
    the demo-backend contract v3 (company-data family; see README.md). It references the SDK
    by PROJECT reference (../../src) so a reader sees which SDK call implements each scenario.
    It is NOT part of the published Allus.CompanyData NuGet package: it is a separate project,
    is not in Allus.CompanyData.slnx, and `dotnet pack` on the SDK never sees it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Allus.CompanyDataExample</RootNamespace>
    <AssemblyName>allus-company-data-example</AssemblyName>
    <!-- Never pack/publish this example as a NuGet package. -->
    <IsPackable>false</IsPackable>
    <!-- Built against the net8.0 LTS surface; roll forward so it runs on any installed >= 8 runtime. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK under test — the intended top-level surface each handler calls. -->
    <ProjectReference Include="../../src/Allus.CompanyData/Allus.CompanyData.csproj" />
  </ItemGroup>

</Project>
