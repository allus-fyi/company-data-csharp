<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The allus company-data C# SDK example test suite.

    ONE project that hosts a thin localhost backend implementing the demo-backend
    contract (contractVersion 3) for ALL THREE scenario families in one server on
    one port:
      identity/     — sign in / OIDC / 2FA          (scenarios 1–8)
      flow/         — run a contract flow            (flow:run)
      company-data/ — connections / fields / changes / webhooks / documents
                                                      (the five companydata:*)

    Shared scaffolding (Program / Runtime / Dispatcher / Web) lives at the project
    root; each family's scenario handlers live in its own folder + namespace, so a
    reader opens a family's handler file and sees the SDK calls.

    In a repository checkout it references the SDK by PROJECT reference (../src) so a
    reader sees which SDK call implements each scenario; from an extracted package it
    falls back to a PackageReference (see the ItemGroup below). It is not a separately
    published package: it is a separate project and is not in the SDK solution — but
    since #493 its SOURCE ships inside the Allus.CompanyData nupkg (at examples/), so an
    installing developer does get it. IsPackable=false keeps it from being published as
    its own package.

    The OIDC scenarios (5/6) use the standard third-party IdentityModel.OidcClient —
    that a real OIDC client drives them is the point of the #314 demonstration.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Allus.ExampleTestSuite</RootNamespace>
    <AssemblyName>allus-example-test-suite</AssemblyName>
    <!-- Never pack/publish this example as a NuGet package. -->
    <IsPackable>false</IsPackable>
    <!-- Built against the net8.0 LTS surface; roll forward so it runs on any installed >= 8 runtime. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK under test — the intended top-level surface each handler calls. -->
    <!-- Resolved by context (#493): the suite's SOURCE ships inside the published
         Allus.CompanyData package, and that nupkg carries lib/net8.0 + examples/ but NOT
         src/, so a ProjectReference cannot resolve from an installed copy. In a repository
         checkout the project reference is used (the suite exercises the working tree, as
         before); everywhere else the matching released package is. -->
    <ProjectReference Include="../src/Allus.CompanyData/Allus.CompanyData.csproj"
                      Condition="Exists('../src/Allus.CompanyData/Allus.CompanyData.csproj')" />
    <PackageReference Include="Allus.CompanyData" Version="0.0.13"
                      Condition="!Exists('../src/Allus.CompanyData/Allus.CompanyData.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Standard .NET OIDC client for identity scenarios 5/6 (discovery + PKCE + id_token
         verification; client_secret_post; issuer/endpoint override for local stacks). -->
    <PackageReference Include="IdentityModel.OidcClient" Version="6.0.0" />
  </ItemGroup>

</Project>
